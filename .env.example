# 複製成 .env 後按需要修改
PORT=3000
HOST=0.0.0.0

# 資料庫與備份放在哪裡（相對於專案根目錄）
DATA_DIR=./data

# 聚會 QR 內用的網址。留空＝自動由請求的 Host 推導。
# 區網用固定 IP 時建議填死，例如 http://192.168.1.50:3000
APP_BASE_URL=

# 首次執行 npm run setup 時建立的管理員帳號
ADMIN_NAME=管理員
ADMIN_PASSWORD=

# 想用 https 讓平板開得到相機時填這兩個（PEM 檔路徑）
TLS_CERT=
TLS_KEY=

# 自助簽到頁的限流：每個 IP＋聚會每分鐘最多幾次操作。
# 同一間辦公室的 Wi-Fi 會共用 IP，人多時可以調高（預設 180）。
PUBLIC_RATE_LIMIT=180

# 設為 1 會在錯誤時印出堆疊（只在除錯時開）
DEBUG=
